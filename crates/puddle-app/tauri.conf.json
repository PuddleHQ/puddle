{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Puddle",
  "identifier": "be.tijsvankampen.puddle",
  "build": {
    "frontendDist": "assets",
    "beforeDevCommand": "npm --prefix ../../ui ci --ignore-scripts && npm --prefix ../../ui run build",
    "windows": { "staticVCRuntime": false }
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "capabilities": ["main"],
      "freezePrototype": false
    }
  },
  "bundle": {
    "active": false,
    "targets": ["msi"],
    "publisher": "Puddle",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "skip" },
      "wix": { "language": "en-US", "template": "wix/main.wxs" }
    }
  }
}
