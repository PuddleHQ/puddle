#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-or-later
# Fast gates before each commit. Enable once per clone: git config core.hooksPath .githooks
top=$(git rev-parse --show-toplevel)
# git exports GIT_DIR and friends to hooks; left set, every git command a gate or a test runs
# would act on this repository whatever its working directory. In a linked worktree a `git init`
# in a temp dir then rewrote the shared config (`core.bare = true`). The gates find the
# repository from their working directory (same as the pre-push hook).
for var in $(git rev-parse --local-env-vars); do unset "$var"; done
exec "$top/scripts/check.sh" fast
