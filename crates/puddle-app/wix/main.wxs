<?xml version="1.0" encoding="utf-8"?>
<!--
  SPDX-License-Identifier: AGPL-3.0-or-later

  Puddle's installer template for Tauri's WiX 3 bundler (`bundle.windows.wix.template`). It replaces
  Tauri's own because that one installs per machine, under Program Files, for administrators only.
  This one installs per user, under %LOCALAPPDATA%\Programs\Puddle, and needs no administrator
  rights; `ci/build-msi.sh` builds it and `ci/msi-install-test.ps1` installs, runs, upgrades and
  removes it on a clean runner. The double-brace values are Tauri's (Handlebars), filled in at build time.

  What differs from Tauri's template, and why:
  - InstallScope is perUser and INSTALLDIR is set by a SetDirectory action instead of sitting
    under LocalAppDataFolder in the Directory table. The files then do not trip ICE38, ICE64 and
    ICE91 (which want a registry key path for every component in the user profile; Tauri's
    generated resource components use files). SetDirectory is a built-in action, not a script.
  - No custom action runs a script or downloads anything (no WebView2 bootstrapper, no update
    task): a missing WebView2 runtime stops the install with a message naming it.
  - No desktop shortcut, file associations, deep links or merge modules: the program has none.
  - The program asks for no PATH change.
  - The installer's own pages (PuddleSetupDlg, PuddleCustomDlg, PuddleFinishDlg, PuddleFailedDlg) replace WixUI's
    welcome, folder, finish and failure pages, and the stock ones are switched off through their overridable
    Show rows: a first page with Install ("Default setup": per-user folder, no more questions) and Custom setup
    (folder, launch box), then the progress page, then a finish page. The artwork is in wix/artwork (drawn by
    ci/make-installer-artwork.py, named by tauri.conf.json), and the package turns on Windows Installer's own
    log (MsiLogging) so the finish and failure pages can name it and open it.
  - The install refuses while the shell or a workspace runtime runs (see PuddleRunning below); an
    uninstall instead offers to quit Puddle and go on (PuddleStop; PuddleAskStop asks in the basic interface of msiexec /x), and to remove everything Puddle
    keeps on the computer (PuddleRemoveAll), both off unless the person chooses them.
-->
<?if $(sys.BUILDARCH)="x64"?>
    <?define Win64 = "yes" ?>
<?elseif $(sys.BUILDARCH)="arm64"?>
    <?define Win64 = "yes" ?>
<?else?>
    <?error Unsupported value of sys.BUILDARCH=$(sys.BUILDARCH)?>
<?endif?>

<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi" xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">
    <Product
            Id="*"
            Name="{{product_name}}"
            UpgradeCode="{{upgrade_code}}"
            Language="!(loc.TauriLanguage)"
            Manufacturer="{{manufacturer}}"
            Version="{{version}}">

        <Package Id="*"
                 Keywords="Installer"
                 InstallerVersion="500"
                 Languages="0"
                 Compressed="yes"
                 InstallScope="perUser"
                 SummaryCodepage="!(loc.TauriCodepage)"/>

        {{#if banner_path}}
        <WixVariable Id="WixUIBannerBmp" Value="{{banner_path}}" />
        {{/if}}
        {{#if dialog_image_path}}
        <WixVariable Id="WixUIDialogBmp" Value="{{dialog_image_path}}" />
        {{/if}}

        <!-- Windows Installer writes a verbose log of every run to the person's Temp folder (MSI<random>.LOG) and
             sets MsiLogFileLocation to its path, so the finish and failure pages can name it and open it. A run that
             names its own log (msiexec /l) keeps that one and leaves the property unset: the pages then say so. -->
        <Property Id="MsiLogging" Value="voicewarmup" />

        <!-- Reinstall all files, rewrite registry entries and shortcuts. -->
        <Property Id="REINSTALLMODE" Value="amus" />

        {{#if allow_downgrades}}
            <MajorUpgrade Schedule="afterInstallInitialize" AllowDowngrades="yes" />
        {{else}}
            <MajorUpgrade Schedule="afterInstallInitialize" DowngradeErrorMessage="!(loc.DowngradeErrorMessage)" AllowSameVersionUpgrades="yes" />
        {{/if}}

        <InstallExecuteSequence>
            <RemoveShortcuts>Installed AND NOT UPGRADINGPRODUCTCODE</RemoveShortcuts>
            <!-- The "Start Puddle when I sign in" entry is written by the program itself (its Settings
                 switch), so the installer does not own it and Windows Installer would not remove it.
                 An uninstall deletes it, or every sign-in would start a program that is gone; an
                 upgrade (UPGRADINGPRODUCTCODE) keeps it. ci/msi-install-test.ps1 checks both. -->
            <Custom Action="RemoveStartAtSignIn" After="RemoveFiles">REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE</Custom>
        </InstallExecuteSequence>

        <!-- The installer never replaces files under a running Puddle and never ends it by force.
             The compiled action of WixUtilExtension that reads the CloseApplication rows (no script)
             only looks: the rows below set a property when the shell (puddle-app.exe) or a
             workspace runtime (msb.exe) runs, and name no close message, no end-session message and
             no process termination, so it asks nothing of the program. The extension schedules its
             own run after the old version is already removed, too late, so PuddleDetect runs the
             same entry point before InstallValidate. PuddleRunning then stops the install with
             the message, before InstallInitialize, so nothing has been changed:
             the installed files, its data and its workspaces stay as they were, and no file is
             queued for replacement at the next restart. A silent run exits with the standard
             failure code and the same text in its log. ci/msi-install-test.ps1 checks all of it. -->
        <util:CloseApplication Id="PuddleShellRunning" Target="puddle-app.exe" Property="PUDDLE_SHELL_RUNNING" RebootPrompt="no" />
        <util:CloseApplication Id="PuddleRuntimeRunning" Target="msb.exe" Property="PUDDLE_RUNTIME_RUNNING" RebootPrompt="no" />
        <CustomAction Id="PuddleDetect" BinaryKey="WixCA" DllEntry="WixCloseApplications" Execute="immediate" Return="check" SuppressModularization="yes" />
        <CustomAction Id="PuddleDetectAgain" BinaryKey="WixCA" DllEntry="WixCloseApplications" Execute="immediate" Return="check" SuppressModularization="yes" />
        <CustomAction Id="PuddleRunning" Error="Puddle is running. Quit Puddle from its tray icon (this stops your workspaces), then run this installer again." />
        <!-- The detection only ever sets its two properties, never clears them, so each run starts
             from "0" (a value from the dialog's own run must not outlive a Puddle quit meanwhile). -->
        <CustomAction Id="PuddleForgetShell" Property="PUDDLE_SHELL_RUNNING" Value="0" />
        <CustomAction Id="PuddleForgetRuntime" Property="PUDDLE_RUNTIME_RUNNING" Value="0" />
        <CustomAction Id="PuddleForgetShellAgain" Property="PUDDLE_SHELL_RUNNING" Value="0" />
        <CustomAction Id="PuddleForgetRuntimeAgain" Property="PUDDLE_RUNTIME_RUNNING" Value="0" />
        <!-- The uninstall's two choices, both off unless set: in the dialog (checkbox, and Remove when
             Puddle runs), or on the command line of a silent run (PUDDLE_STOP_RUNNING=1,
             PUDDLE_REMOVE_ALL=1). puddle-uninstall.ps1 (installed beside the program) does the work. -->
        <Property Id="PUDDLE_STOP_RUNNING" Secure="yes" />
        <Property Id="PUDDLE_REMOVE_ALL" Secure="yes" />
        <!-- Windows' "Apps" list and Control Panel start an uninstall with msiexec /x, which runs the
             basic user interface (UILevel 3): the installer's own dialogs, PuddleRemoveDlg among them,
             are never shown, only the "are you sure" box and a progress bar. There the offer is a Yes/No
             box drawn by msiexec's own client: an error-type message (INSTALLMESSAGE_ERROR, the route the
             "Puddle is running" refusal takes) with Yes/No buttons. An inline script runs its top-level code only (no entry function is called),
             so the statements stand at the top. A silent run (UILevel 2) gets no box and keeps refusing
             unless PUDDLE_STOP_RUNNING=1. -->
        <CustomAction Id="PuddleAskStop" Script="vbscript" Execute="immediate" Return="ignore"><![CDATA[
            Dim rec
            Set rec = Session.Installer.CreateRecord(0)
            rec.StringData(0) = "Puddle is running. Quit it now (this stops your workspaces cleanly) and remove it?"
            If Session.Message(&H01000000 + 4 + 32, rec) = 6 Then Session.Property("PUDDLE_STOP_RUNNING") = "1"
        ]]></CustomAction>
        <CustomAction Id="PuddleStop" Directory="INSTALLDIR" Execute="immediate" Impersonate="yes" Return="ignore"
            ExeCommand="&quot;[SystemFolder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[INSTALLDIR]uninstall\puddle-uninstall.ps1&quot; -Stop" />
        <CustomAction Id="PuddleRemoveAll" Directory="INSTALLDIR" Execute="deferred" Impersonate="yes" Return="ignore"
            ExeCommand="&quot;[SystemFolder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[INSTALLDIR]uninstall\puddle-uninstall.ps1&quot; -RemoveAll" />
        <InstallExecuteSequence>
            <Custom Action="PuddleForgetShell" Before="PuddleDetect" />
            <Custom Action="PuddleForgetRuntime" After="PuddleForgetShell" />
            <Custom Action="PuddleDetect" Before="InstallValidate" />
            <Custom Action="PuddleAskStop" After="PuddleDetect"><![CDATA[REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE AND UILevel >= 3 AND NOT PUDDLE_STOP_RUNNING AND ((PUDDLE_SHELL_RUNNING <> "" AND PUDDLE_SHELL_RUNNING <> "0") OR (PUDDLE_RUNTIME_RUNNING <> "" AND PUDDLE_RUNTIME_RUNNING <> "0"))]]></Custom>
            <Custom Action="PuddleStop" After="PuddleAskStop"><![CDATA[REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE AND PUDDLE_STOP_RUNNING="1" AND ((PUDDLE_SHELL_RUNNING <> "" AND PUDDLE_SHELL_RUNNING <> "0") OR (PUDDLE_RUNTIME_RUNNING <> "" AND PUDDLE_RUNTIME_RUNNING <> "0"))]]></Custom>
            <Custom Action="PuddleForgetShellAgain" After="PuddleStop"><![CDATA[REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE AND PUDDLE_STOP_RUNNING="1"]]></Custom>
            <Custom Action="PuddleForgetRuntimeAgain" After="PuddleForgetShellAgain"><![CDATA[REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE AND PUDDLE_STOP_RUNNING="1"]]></Custom>
            <Custom Action="PuddleDetectAgain" After="PuddleForgetRuntimeAgain"><![CDATA[REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE AND PUDDLE_STOP_RUNNING="1"]]></Custom>
            <Custom Action="PuddleRunning" After="PuddleDetectAgain"><![CDATA[(PUDDLE_SHELL_RUNNING <> "" AND PUDDLE_SHELL_RUNNING <> "0") OR (PUDDLE_RUNTIME_RUNNING <> "" AND PUDDLE_RUNTIME_RUNNING <> "0")]]></Custom>
            <Custom Action="PuddleRemoveAll" Before="RemoveFiles"><![CDATA[REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE AND PUDDLE_REMOVE_ALL="1"]]></Custom>
        </InstallExecuteSequence>
        <!-- The page order: PuddleSetupDlg first (in the place of WixUI's WelcomeDlg), the progress page, and
             after the install PuddleFinishDlg (a normal step after ExecuteAction, which a failed or cancelled run
             never reaches). A failed run ends on PuddleFailedDlg in the place of WixUI's FatalError. WixUI marks
             its own Show rows overridable, so a row of the same dialog with a false condition replaces each. -->
        <InstallUISequence>
            <Show Dialog="WelcomeDlg" Before="ProgressDlg">0</Show>
            <Show Dialog="PuddleSetupDlg" Before="ProgressDlg">NOT Installed OR PATCH</Show>
            <Show Dialog="ExitDialog" OnExit="success">0</Show>
            <Show Dialog="PuddleFinishDlg" After="ExecuteAction">1</Show>
            <Show Dialog="FatalError" OnExit="error">0</Show>
            <Show Dialog="PuddleFailedDlg" OnExit="error" />
        </InstallUISequence>
        <!-- The dialog below needs to know whether Puddle runs, before the install starts. -->
        <InstallUISequence>
            <Custom Action="PuddleForgetShell" Sequence="1205">REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE</Custom>
            <Custom Action="PuddleForgetRuntime" Sequence="1206">REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE</Custom>
            <Custom Action="PuddleDetect" Sequence="1210">REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE</Custom>
            <Show Dialog="PuddleRemoveDlg" Sequence="1220">REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE</Show>
        </InstallUISequence>

        <Media Id="1" Cabinet="app.cab" EmbedCab="yes" />

        <!-- The Id ends in ".ico" on purpose: Windows Installer writes the icon to a file of that name and
             takes the type from the extension, and a shortcut whose icon file has none shows a generic icon.
             the template value icon_path is icons/icon.ico (the duck at 16 to 256 px), also the program's own icon.
             ci/msi-install-test.ps1 checks the Icon table and the shown icons. -->
        <Icon Id="ProductIcon.ico" SourceFile="{{icon_path}}"/>
        <Property Id="ARPPRODUCTICON" Value="ProductIcon.ico" />
        <Property Id="ARPNOREPAIR" Value="yes" Secure="yes" />
        <SetProperty Id="ARPNOMODIFY" Value="1" After="InstallValidate" Sequence="execute"/>
        {{#if homepage}}
        <Property Id="ARPURLINFOABOUT" Value="{{homepage}}"/>
        <Property Id="ARPHELPLINK" Value="{{homepage}}"/>
        {{/if}}

        <!-- WebView2 is on Windows 11 and installed with Edge on Windows 10; the installer does not
             fetch it. These are the keys Microsoft documents for detecting it. -->
        <Property Id="INSTALLED_WEBVIEW2_VERSION">
            <RegistrySearch Id="Webview2VersionSystemx64" Root="HKLM" Key="SOFTWARE\WOW6432Node\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}" Name="pv" Type="raw" />
            <RegistrySearch Id="Webview2VersionSystemx86" Root="HKLM" Key="SOFTWARE\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}" Name="pv" Type="raw" />
            <RegistrySearch Id="Webview2VersionUser" Root="HKCU" Key="SOFTWARE\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}" Name="pv" Type="raw" />
        </Property>
        <Condition Message="Puddle needs the Microsoft Edge WebView2 Runtime, which comes with Windows 11 and with Microsoft Edge on Windows 10. Install it from https://developer.microsoft.com/microsoft-edge/webview2/ and run this installer again.">
            <![CDATA[Installed OR INSTALLED_WEBVIEW2_VERSION]]>
        </Condition>

        <!-- The folder of an earlier install, so an upgrade stays where the first install went. -->
        <Property Id="INSTALLDIR">
            <RegistrySearch Id="PrevInstallDir" Root="HKCU" Key="Software\\{{manufacturer}}\\{{product_name}}" Name="InstallDir" Type="raw" />
        </Property>

        <!-- Launch checkbox on the last page. -->
        <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="!(loc.LaunchApp)" />
        <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1"/>
        <CustomAction Id="RemoveStartAtSignIn" Directory="TARGETDIR" ExeCommand="&quot;[SystemFolder]reg.exe&quot; delete &quot;HKCU\Software\Microsoft\Windows\CurrentVersion\Run&quot; /v &quot;{{product_name}}&quot; /f" Impersonate="yes" Return="ignore" />
        <CustomAction Id="LaunchApplication" Impersonate="yes" FileKey="Path" ExeCommand="" Return="asyncNoWait" />
        <CustomAction Id="OpenSetupLog" Directory="TARGETDIR" Impersonate="yes" Return="asyncNoWait"
            ExeCommand="&quot;[SystemFolder]notepad.exe&quot; &quot;[MsiLogFileLocation]&quot;" />

        <UI>
            <Property Id="WIXUI_INSTALLDIR" Value="INSTALLDIR" />

            <!-- The "Installing" page shows one line per action and, below it, a template filled in for
                 each item the action handles. Windows Installer's built-in texts are raw
                 ("Copying new files", then "File: [1], Directory: [9], Size: [6]" for each of the
                 thousands of files), and a package that sets no text shows those. Each action below
                 has a plain sentence and no template, so no per-item line is shown.
                 ci/msi-install-test.ps1 reads the built MSI's ActionText table and fails on a "[". -->
            <ProgressText Action="InstallFiles">Copying Puddle's files. This takes about a minute.</ProgressText>
            <ProgressText Action="CreateFolders">Creating Puddle's folders</ProgressText>
            <ProgressText Action="RemoveFolders">Removing Puddle's folders</ProgressText>
            <ProgressText Action="RemoveFiles">Removing Puddle's files</ProgressText>
            <ProgressText Action="CreateShortcuts">Adding Puddle to the Start menu</ProgressText>
            <ProgressText Action="RemoveShortcuts">Removing Puddle from the Start menu</ProgressText>
            <ProgressText Action="WriteRegistryValues">Saving where Puddle is installed</ProgressText>
            <ProgressText Action="RemoveRegistryValues">Removing the saved install settings</ProgressText>
            <ProgressText Action="RegisterUser">Registering Puddle for your Windows account</ProgressText>
            <ProgressText Action="RegisterProduct">Adding Puddle to the Windows list of installed apps</ProgressText>
            <ProgressText Action="PublishProduct">Adding Puddle to the Windows list of installed apps</ProgressText>
            <ProgressText Action="PublishFeatures">Adding Puddle to the Windows list of installed apps</ProgressText>
            <ProgressText Action="UnpublishFeatures">Removing Puddle from the Windows list of installed apps</ProgressText>
            <ProgressText Action="RemoveExistingProducts">Removing the previous version of Puddle</ProgressText>
            <ProgressText Action="ProcessComponents">Updating the list of Puddle's files</ProgressText>
            <ProgressText Action="FindRelatedProducts">Looking for an earlier version of Puddle</ProgressText>
            <ProgressText Action="AppSearch">Checking this computer</ProgressText>
            <ProgressText Action="MigrateFeatureStates">Checking earlier install choices</ProgressText>
            <ProgressText Action="RollbackCleanup">Cleaning up temporary files</ProgressText>
            <ProgressText Action="InstallFinalize">Finishing the installation</ProgressText>
            <ProgressText Action="InstallAdminPackage">Copying Puddle's files to the chosen folder</ProgressText>


            <!-- The uninstall's own page (the program's own list, not WixUI's): what goes, what stays,
                 the offer to quit a running Puddle, and the removal of everything Puddle keeps. -->
            <Dialog Id="PuddleRemoveDlg" Width="370" Height="270" Title="[ProductName] Setup">
                <Control Id="Title" Type="Text" X="20" Y="12" Width="330" Height="20" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Remove Puddle" />
                <Control Id="Kept" Type="Text" X="20" Y="40" Width="330" Height="34" Transparent="yes" NoPrefix="yes"
                    Text="Puddle's program files and its Start menu entry are removed. Your workspaces, their disks and your settings stay on this computer unless you tick the box below." />
                <Control Id="RunningNotice" Type="Text" X="20" Y="80" Width="330" Height="34" Transparent="yes" NoPrefix="yes"
                    Text="Puddle is running. Choosing Remove quits it first, and stops your workspaces cleanly.">
                    <Condition Action="hide"><![CDATA[NOT ((PUDDLE_SHELL_RUNNING <> "" AND PUDDLE_SHELL_RUNNING <> "0") OR (PUDDLE_RUNTIME_RUNNING <> "" AND PUDDLE_RUNTIME_RUNNING <> "0"))]]></Condition>
                </Control>
                <Control Id="RemoveAllBox" Type="CheckBox" X="20" Y="122" Width="330" Height="18" Property="PUDDLE_REMOVE_ALL" CheckBoxValue="1"
                    Text="Also remove all of Puddle's files from this computer" />
                <Control Id="RemoveAllList" Type="Text" X="38" Y="142" Width="312" Height="80" Transparent="yes" NoPrefix="yes"
                    Text="This deletes, for good: every workspace and its disk, your Puddle settings and the activity log, the workspaces' repositories that Puddle keeps, its logs, the saved window state, the development certificate Puddle added to your trusted certificates, and the Include line Puddle added to your ssh config. Leave it unticked to keep them." />
                <Control Id="Remove" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="&amp;Remove">
                    <Publish Property="PUDDLE_STOP_RUNNING" Value="1" Order="1"><![CDATA[(PUDDLE_SHELL_RUNNING <> "" AND PUDDLE_SHELL_RUNNING <> "0") OR (PUDDLE_RUNTIME_RUNNING <> "" AND PUDDLE_RUNTIME_RUNNING <> "0")]]></Publish>
                    <Publish Event="EndDialog" Value="Return" Order="2">1</Publish>
                </Control>
                <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Cancel">
                    <Publish Event="EndDialog" Value="Exit">1</Publish>
                </Control>
            </Dialog>

            <DialogRef Id="CancelDlg" />
            <DialogRef Id="InvalidDirDlg" />

            <!-- The installer's own pages. WixUI's welcome, folder, ready, finish and failure pages stay in the
                 package (other pages point at them) but are not shown: their Show rows are switched off below. -->

            <!-- First page. Install is the "Default setup": the per-user folder and nothing more to answer, straight
                 to the progress page. Custom setup goes to the next page (folder and launch box). -->
            <Dialog Id="PuddleSetupDlg" Width="370" Height="270" Title="[ProductName] Setup">
                <Control Id="Bitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="234" TabSkip="no" Text="WixUI_Bmp_Dialog" />
                <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
                <Control Id="Title" Type="Text" X="135" Y="20" Width="220" Height="30" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Bigger}Install Puddle" />
                <Control Id="Description" Type="Text" X="135" Y="56" Width="220" Height="40" Transparent="yes" NoPrefix="yes"
                    Text="Puddle runs your coding agents in safe workspaces on this computer." />
                <Control Id="DefaultNote" Type="Text" X="135" Y="104" Width="220" Height="56" Transparent="yes" NoPrefix="yes"
                    Text="Install sets Puddle up for you only, in your own Programs folder, and needs no administrator rights. Choose Custom setup to pick another folder." />
                <Control Id="Install" Type="PushButton" X="150" Y="243" Width="60" Height="17" Default="yes" Text="&amp;Install">
                    <Publish Event="SetTargetPath" Value="[WIXUI_INSTALLDIR]" Order="1">1</Publish>
                    <Publish Event="EndDialog" Value="Return" Order="2">1</Publish>
                </Control>
                <Control Id="Custom" Type="PushButton" X="214" Y="243" Width="84" Height="17" Text="&amp;Custom setup">
                    <Publish Event="NewDialog" Value="PuddleCustomDlg">1</Publish>
                </Control>
                <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Cancel">
                    <Publish Event="SpawnDialog" Value="CancelDlg">1</Publish>
                </Control>
            </Dialog>

            <!-- Custom setup: the folder (checked the way WixUI's folder page checks it) and whether Puddle opens
                 when setup ends; Install goes straight to the progress page. -->
            <Dialog Id="PuddleCustomDlg" Width="370" Height="270" Title="[ProductName] Setup">
                <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner" />
                <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
                <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
                <Control Id="Title" Type="Text" X="15" Y="6" Width="300" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Custom setup" />
                <Control Id="Description" Type="Text" X="25" Y="23" Width="300" Height="15" Transparent="yes" NoPrefix="yes" Text="Choose where Puddle goes and what happens when setup ends." />
                <Control Id="FolderLabel" Type="Text" X="20" Y="60" Width="320" Height="18" NoPrefix="yes" Text="Install Puddle in this folder:" />
                <Control Id="Folder" Type="PathEdit" X="20" Y="82" Width="320" Height="18" Property="WIXUI_INSTALLDIR" Indirect="yes" />
                <Control Id="ChangeFolder" Type="PushButton" X="20" Y="104" Width="56" Height="17" Text="&amp;Change...">
                    <Publish Property="_BrowseProperty" Value="[WIXUI_INSTALLDIR]" Order="1">1</Publish>
                    <Publish Event="SpawnDialog" Value="BrowseDlg" Order="2">1</Publish>
                </Control>
                <Control Id="LaunchBox" Type="CheckBox" X="20" Y="146" Width="320" Height="18" Property="WIXUI_EXITDIALOGOPTIONALCHECKBOX" CheckBoxValue="1" Text="&amp;Open Puddle when setup ends" />
                <Control Id="Back" Type="PushButton" X="150" Y="243" Width="56" Height="17" Text="&amp;Back">
                    <Publish Event="NewDialog" Value="PuddleSetupDlg">1</Publish>
                </Control>
                <Control Id="Install" Type="PushButton" X="214" Y="243" Width="84" Height="17" Default="yes" Text="&amp;Install">
                    <Publish Event="SetTargetPath" Value="[WIXUI_INSTALLDIR]" Order="1">1</Publish>
                    <Publish Event="DoAction" Value="WixUIValidatePath" Order="2">NOT WIXUI_DONTVALIDATEPATH</Publish>
                    <Publish Event="SpawnDialog" Value="InvalidDirDlg" Order="3"><![CDATA[NOT WIXUI_DONTVALIDATEPATH AND WIXUI_INSTALLDIR_VALID<>"1"]]></Publish>
                    <Publish Event="EndDialog" Value="Return" Order="4">WIXUI_DONTVALIDATEPATH OR WIXUI_INSTALLDIR_VALID="1"</Publish>
                </Control>
                <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Cancel">
                    <Publish Event="SpawnDialog" Value="CancelDlg">1</Publish>
                </Control>
            </Dialog>

            <!-- Last page of a run that worked (an install, an upgrade or a removal): what happened, the box that
                 opens Puddle, where the log is and a button that opens it. -->
            <Dialog Id="PuddleFinishDlg" Width="370" Height="270" Title="[ProductName] Setup">
                <Control Id="Bitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="234" TabSkip="no" Text="WixUI_Bmp_Dialog" />
                <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
                <Control Id="TitleInstalled" Type="Text" X="135" Y="20" Width="220" Height="30" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Bigger}Puddle is installed">
                    <Condition Action="hide"><![CDATA[REMOVE~="ALL"]]></Condition>
                </Control>
                <Control Id="TitleRemoved" Type="Text" X="135" Y="20" Width="220" Height="30" Transparent="yes" NoPrefix="yes" Hidden="yes" Text="{\WixUI_Font_Bigger}Puddle is removed">
                    <Condition Action="show"><![CDATA[REMOVE~="ALL"]]></Condition>
                </Control>
                <Control Id="Description" Type="Text" X="135" Y="56" Width="220" Height="40" Transparent="yes" NoPrefix="yes" Text="Choose Finish to close setup. You can start Puddle from the Start menu." />
                <Control Id="OptionalCheckBox" Type="CheckBox" X="135" Y="104" Width="220" Height="18" Hidden="yes" Property="WIXUI_EXITDIALOGOPTIONALCHECKBOX" CheckBoxValue="1" Text="[WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT]">
                    <Condition Action="show"><![CDATA[NOT Installed AND NOT (REMOVE~="ALL")]]></Condition>
                </Control>
                <Control Id="LogLabel" Type="Text" X="135" Y="140" Width="220" Height="12" Transparent="yes" NoPrefix="yes" Hidden="yes" Text="The setup log is saved here:">
                    <Condition Action="show">MsiLogFileLocation</Condition>
                </Control>
                <Control Id="LogPath" Type="Text" X="135" Y="154" Width="220" Height="36" Transparent="yes" NoPrefix="yes" Hidden="yes" Text="[MsiLogFileLocation]">
                    <Condition Action="show">MsiLogFileLocation</Condition>
                </Control>
                <Control Id="NoLog" Type="Text" X="135" Y="140" Width="220" Height="36" Transparent="yes" NoPrefix="yes" Text="This run was started with its own log file, named on its command line.">
                    <Condition Action="hide">MsiLogFileLocation</Condition>
                </Control>
                <Control Id="OpenLog" Type="PushButton" X="135" Y="196" Width="84" Height="17" Hidden="yes" Text="Open the &amp;log">
                    <Condition Action="show">MsiLogFileLocation</Condition>
                    <Publish Event="DoAction" Value="OpenSetupLog">1</Publish>
                </Control>
                <Control Id="Finish" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Cancel="yes" Text="&amp;Finish">
                    <Publish Event="DoAction" Value="LaunchApplication" Order="1">WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed</Publish>
                    <Publish Event="EndDialog" Value="Return" Order="2">1</Publish>
                </Control>
            </Dialog>

            <!-- The page of a run that failed. Windows Installer has already undone what the run changed. -->
            <Dialog Id="PuddleFailedDlg" Width="370" Height="270" Title="[ProductName] Setup">
                <Control Id="Bitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="234" TabSkip="no" Text="WixUI_Bmp_Dialog" />
                <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
                <Control Id="Title" Type="Text" X="135" Y="20" Width="220" Height="30" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Bigger}Puddle setup did not finish" />
                <Control Id="Description" Type="Text" X="135" Y="56" Width="220" Height="64" Transparent="yes" NoPrefix="yes"
                    Text="Something went wrong, and Windows has undone what setup changed. The setup log says what happened. Keep it when you report the problem." />
                <Control Id="LogLabel" Type="Text" X="135" Y="130" Width="220" Height="12" Transparent="yes" NoPrefix="yes" Hidden="yes" Text="The setup log is saved here:">
                    <Condition Action="show">MsiLogFileLocation</Condition>
                </Control>
                <Control Id="LogPath" Type="Text" X="135" Y="144" Width="220" Height="36" Transparent="yes" NoPrefix="yes" Hidden="yes" Text="[MsiLogFileLocation]">
                    <Condition Action="show">MsiLogFileLocation</Condition>
                </Control>
                <Control Id="NoLog" Type="Text" X="135" Y="130" Width="220" Height="36" Transparent="yes" NoPrefix="yes" Text="This run was started with its own log file, named on its command line.">
                    <Condition Action="hide">MsiLogFileLocation</Condition>
                </Control>
                <Control Id="OpenLog" Type="PushButton" X="135" Y="190" Width="84" Height="17" Hidden="yes" Text="Open the &amp;log">
                    <Condition Action="show">MsiLogFileLocation</Condition>
                    <Publish Event="DoAction" Value="OpenSetupLog">1</Publish>
                </Control>
                <Control Id="Finish" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Cancel="yes" Text="&amp;Finish">
                    <Publish Event="EndDialog" Value="Exit">1</Publish>
                </Control>
            </Dialog>

        </UI>

        <UIRef Id="WixUI_InstallDir" />

        <Directory Id="TARGETDIR" Name="SourceDir">
            <Directory Id="INSTALLDIR" Name="{{product_name}}"/>
            <Directory Id="ProgramMenuFolder">
                <Directory Id="ApplicationProgramsFolder" Name="{{product_name}}"/>
            </Directory>
        </Directory>

        <!-- A first install goes to %LOCALAPPDATA%\Programs\<name>, the per-user programs folder. -->
        <SetDirectory Id="INSTALLDIR" Value="[LocalAppDataFolder]Programs\\{{product_name}}">NOT INSTALLDIR</SetDirectory>

        <DirectoryRef Id="INSTALLDIR">
            <Component Id="RegistryEntries" Guid="*">
                <RegistryKey Root="HKCU" Key="Software\\{{manufacturer}}\\{{product_name}}">
                    <RegistryValue Name="InstallDir" Type="string" Value="[INSTALLDIR]" KeyPath="yes" />
                </RegistryKey>
            </Component>
            <Component Id="Path" Guid="{{path_component_guid}}" Win64="$(var.Win64)">
                <File Id="Path" Source="{{main_binary_path}}" KeyPath="yes" Checksum="yes"/>
            </Component>
            {{#each binaries as |bin| ~}}
            <Component Id="{{ bin.id }}" Guid="{{bin.guid}}" Win64="$(var.Win64)">
                <File Id="Bin_{{ bin.id }}" Source="{{bin.path}}" KeyPath="yes"/>
            </Component>
            {{/each~}}
            {{resources}}
            <Component Id="CMP_RemoveInstallDir" Guid="*">
                <RemoveFolder Id="RemoveInstallDir" On="uninstall" />
                <RegistryValue Root="HKCU" Key="Software\\{{manufacturer}}\\{{product_name}}" Name="Install Folder" Type="integer" Value="1" KeyPath="yes" />
            </Component>
        </DirectoryRef>

        <DirectoryRef Id="ApplicationProgramsFolder">
            <Component Id="ApplicationShortcut" Guid="*">
                <Shortcut Id="ApplicationStartMenuShortcut"
                    Name="{{product_name}}"
                    Description="Runs {{product_name}}"
                    Target="[!Path]"
                    Icon="ProductIcon.ico"
                    WorkingDirectory="INSTALLDIR">
                    <ShortcutProperty Key="System.AppUserModel.ID" Value="{{bundle_id}}"/>
                </Shortcut>
                <RemoveFolder Id="ApplicationProgramsFolder" On="uninstall"/>
                <RegistryValue Root="HKCU" Key="Software\\{{manufacturer}}\\{{product_name}}" Name="Start Menu Shortcut" Type="integer" Value="1" KeyPath="yes"/>
            </Component>
        </DirectoryRef>

        <Feature
                Id="MainProgram"
                Title="Application"
                Description="!(loc.InstallAppFeature)"
                Level="1"
                ConfigurableDirectory="INSTALLDIR"
                AllowAdvertise="no"
                Display="expand"
                Absent="disallow">
            <ComponentRef Id="RegistryEntries"/>
            <ComponentRef Id="Path"/>
            <ComponentRef Id="CMP_RemoveInstallDir"/>
            <ComponentRef Id="ApplicationShortcut"/>
            {{#each binaries as |bin| ~}}
            <ComponentRef Id="{{ bin.id }}"/>
            {{/each~}}
            {{#each resource_file_ids as |resource_file_id| ~}}
            <ComponentRef Id="{{ resource_file_id }}"/>
            {{/each~}}
        </Feature>

        <SetProperty Id="ARPINSTALLLOCATION" Value="[INSTALLDIR]" After="CostFinalize"/>
    </Product>
</Wix>
